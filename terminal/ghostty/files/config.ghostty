# !important "never" edit line

font-family = "MesloLGS NF"
font-codepoint-map = U+1100-U+11FF,U+3130-U+318F,U+A960-U+A97F,U+AC00-U+D7A3,U+D7B0-U+D7FF=Noto Sans CJK KR

font-size = 14.5

term = xterm-256color
font-thicken = true

adjust-cell-height = 20%
background = #080b10
window-padding-x = 16
window-padding-y = 10,5
# window-padding-y = 4,12
window-theme = dark
background-opacity = 0.95
background-blur = 20

# Hide the titlebar for a cleaner look
macos-titlebar-style = hidden

# Small polish
cursor-style = block
cursor-style-blink = false
mouse-hide-while-typing = true

# !important end of "never" edit line

## must addition options under line

# herdr 키 바인딩 (kitty 설정에서 이관). 이 줄을 주석 처리하면 통째로 꺼진다.
# terminal/herdr/install.sh 가 설치하며, 파일이 없으면 ? 접두사 덕에 오류 없이 건너뛴다.
# 주의: 아래 파일이 위의 cmd+d / cmd+shift+d / cmd+방향키 split 바인딩을 덮어쓴다.
config-file = ?{{HOME}}/.config/ghostty/herdr-keys.conf
